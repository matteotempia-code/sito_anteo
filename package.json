{
  "name": "sito-anteo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nuovo sito di Anteo Impresa Sociale",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run verifica:caratteri && astro build",
    "preview": "astro preview",
    "caratteri": "node scripts/prepara-caratteri.mjs",
    "marchio": "node scripts/ottimizza-marchio.mjs",
    "anteprima": "node scripts/genera-anteprima-sito.mjs && node scripts/genera-pagina-sistema.mjs",
    "verifica:contrasto": "node scripts/verifica-contrasto.mjs",
    "verifica:token": "node scripts/verifica-token.mjs",
    "verifica:struttura": "node scripts/verifica-struttura.mjs",
    "verifica:dati": "node --experimental-strip-types scripts/verifica-dati-strutturati.mjs",
    "verifica:caratteri": "node scripts/verifica-caratteri.mjs",
    "verifica": "npm run verifica:contrasto && npm run verifica:token && npm run verifica:dati && npm run verifica:struttura"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/public-sans": "^5.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}
