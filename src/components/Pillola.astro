---
/**
 * La pillola. Una sola, per ogni cosa che si etichetta: settore, stato,
 * priorità. L'audit del prototipo ne aveva trovate quattro varianti della
 * stessa forma.
 */
import type { CodiceSettore } from '../lib/settori';

interface Props {
  /** Colora la pillola con la tinta del settore. */
  settore?: CodiceSettore;
  /**
   * Lo stato di un posto. NON è una tinta: è un glifo su fondo neutro.
   *
   * Il colore, su questo sito, significa settore e nient'altro. Le vecchie
   * varianti «positivo» e «critico» erano il verde di «anziani» e il rosso
   * di «dipendenze» applicati a «posti disponibili» e «lista d'attesa»:
   * la regola del progetto violata dal progetto, e illeggibile per chi i
   * colori non li distingue. Per giunta i due token che citavano non sono
   * mai esistiti, così quelle pillole uscivano senza fondo.
   */
  stato?: 'libero' | 'attesa' | 'invio' | 'aggiornare';
  class?: string;
}

const { settore, stato, class: classe = '' } = Astro.props;
const classi = ['pillola', settore ? `s-${settore}` : stato ? `e-${stato}` : 't-neutro', classe]
  .filter(Boolean)
  .join(' ');
---

<span class={classi}><slot /></span>

<style>
  .pillola {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--raggio-pieno);
    border: 1px solid transparent;
    font-size: var(--corpo-1);
    font-weight: var(--peso-forte);
    line-height: var(--interlinea-media);
    white-space: nowrap;
  }

  .t-neutro {
    background: var(--superficie-alt);
    border-color: var(--bordo);
    color: var(--testo-secondario);
  }
  /* Gli stati si leggono per FORMA, su un fondo che è sempre lo stesso.
     Il glifo è decorativo: il testo accanto dice già tutto.
     Le classi si elencano una per una: [class*='e-'] avrebbe preso anche
     .s-salute-mentale, che contiene «e-m». */
  :is(.e-libero, .e-attesa, .e-invio) {
    background: var(--stato-fondo);
    color: var(--stato-testo);
    border-color: var(--stato-bordo);
  }
  :is(.e-libero, .e-attesa, .e-invio, .e-aggiornare)::before {
    font-size: 0.9em;
    line-height: 1;
  }
  .e-libero::before { content: '\25cf'; }
  .e-attesa::before { content: '\25d0'; }
  .e-invio::before { content: '\25cb'; }
  .e-aggiornare {
    background: var(--attenzione-fondo);
    color: var(--attenzione-testo);
    border-color: var(--attenzione-testo);
  }
  .e-aggiornare::before { content: '\21bb'; }

  .s-salute-mentale {
    background: var(--salute-mentale-fondo);
    color: var(--salute-mentale-testo);
  }
  .s-anziani {
    background: var(--anziani-fondo);
    color: var(--anziani-testo);
  }
  .s-disabilita {
    background: var(--disabilita-fondo);
    color: var(--disabilita-testo);
  }
  .s-minori {
    background: var(--minori-fondo);
    color: var(--minori-testo);
  }
  .s-dipendenze {
    background: var(--dipendenze-fondo);
    color: var(--dipendenze-testo);
  }
  .s-sociale {
    background: var(--sociale-fondo);
    color: var(--sociale-testo);
  }
</style>
