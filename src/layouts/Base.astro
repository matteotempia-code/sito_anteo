---
import '../styles/caratteri.css';
import '../styles/token.css';
import '../styles/base.css';
import Testata from '../components/Testata.astro';
import Piede from '../components/Piede.astro';

/**
 * Lo scheletro di ogni pagina.
 *
 * I caratteri sono auto-ospitati, solo sottoinsieme latino: nessun host di
 * terze parti sul percorso critico. Il sito attuale carica ancora il font
 * delle icone dal server dimostrativo del fornitore del tema — se quel
 * server si spegne, le icone spariscono da anteocoop.it e nessuno in Anteo
 * Impresa Sociale può rimediare. Qui non succede. Le ragioni per esteso, e
 * quella che conta di più (l'indirizzo IP di chi legge, con in chiaro la
 * pagina da cui arriva), stanno in styles/caratteri.css.
 */
import { ORGANIZZAZIONE, SITO_WEB, briciolePerPercorso } from '../lib/dati-strutturati';

interface Props {
  titolo: string;
  descrizione: string;
  /** Fuori dall'indice: aree riservate, pagine di servizio. */
  noindex?: boolean;
  /**
   * Le briciole della pagina, nell'ordine in cui compaiono: [testo, href].
   * Senza, il motore di ricerca mostra l'URL grezzo al posto del percorso,
   * e per una scheda di sede l'URL è lungo quattro livelli.
   */
  briciole?: [string, string][];
  /** Dati strutturati specifici della pagina (una sede, un annuncio). */
  datiPagina?: Record<string, unknown> | Record<string, unknown>[];
}

const { titolo, descrizione, noindex = false, briciole, datiPagina } = Astro.props;
const canonico = new URL(Astro.url.pathname, Astro.site).href;

/**
 * I dati strutturati vanno in un blocco solo, come @graph.
 *
 * Non per eleganza: con più blocchi <script type="application/ld+json">
 * separati, i nodi non possono riferirsi l'uno all'altro e ogni pagina
 * ridichiara l'organizzazione da capo. Con un grafo unico, l'organizzazione
 * ha un @id stabile e tutto il resto la cita — che è come il motore capisce
 * che le 140 schede appartengono allo stesso ente.
 *
 * Regola che vale per tutti: qui dentro non si dichiara niente che non sia
 * anche visibile nella pagina. Dati strutturati che raccontano una cosa
 * diversa dal testo sono una penalizzazione, non un'ottimizzazione.
 */
const grafo: Record<string, unknown>[] = [
  ORGANIZZAZIONE(Astro.site!),
  SITO_WEB(Astro.site!),
  ...(briciole?.length ? [briciolePerPercorso(briciole, Astro.site!)] : []),
  ...(datiPagina ? (Array.isArray(datiPagina) ? datiPagina : [datiPagina]) : []),
];
const datiStrutturati = JSON.stringify({ '@context': 'https://schema.org', '@graph': grafo });
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo} — Anteo Impresa Sociale</title>
    <meta name="description" content={descrizione} />
    <link rel="canonical" href={canonico} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="Anteo Impresa Sociale" />
    <meta property="og:title" content={titolo} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonico} />
    <meta property="og:locale" content="it_IT" />
    <!-- Senza immagine, ogni condivisione su WhatsApp — che per questo
         pubblico è il canale principale — arriva come una scheda vuota. -->
    <meta property="og:image" content={new URL('/condivisione.png', Astro.site).href} />
    <meta property="og:image:alt" content="Anteo Impresa Sociale" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#684a90" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15111d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/marchio/logo-mark.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Si precarica solo il sottoinsieme latino di base, che serve a ogni
         pagina. Il latino esteso (Łukasz, Đorđe) lo scarica il browser da
         sé, e solo dove serve davvero: precaricarlo sempre vorrebbe dire
         far pagare 51 KB a tutti per i nomi di pochi.
         `crossorigin` serve anche per risorse dello stesso dominio, perché
         i font si recuperano sempre in modalità anonima: senza, il browser
         scarica il file due volte. -->
    <link
      rel="preload"
      href="/caratteri/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/caratteri/public-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={datiStrutturati} is:inline />
  </head>
  <body>
    <a class="salta" href="#contenuto">Salta al contenuto</a>
    <Testata />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Piede />
  </body>
</html>
